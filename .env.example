##############################################################################
# docker-conan-exiles-enhanced-server -- environment configuration template
#
# Copy this file to .env and edit as needed.
# Lines starting with # are comments.
##############################################################################

# ---------------------------------------------------------------------------
# Container runtime
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000

# Set to false to skip the automatic server update on every container start.
UPDATE_ON_START=true

# ---------------------------------------------------------------------------
# Network ports
# ---------------------------------------------------------------------------
PORT=7777
QUERY_PORT=27015
RCON_PORT=25575

# ---------------------------------------------------------------------------
# Basic server identity
# ---------------------------------------------------------------------------
MAX_PLAYERS=40
SERVER_NAME=Conan Exiles Enhanced Server
SERVER_PASSWORD=
RCON_PASSWORD=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Mods (comma-separated Steam Workshop IDs)
# ---------------------------------------------------------------------------
MODS=

# ---------------------------------------------------------------------------
# Extra command-line switches passed verbatim to the server executable.
# ---------------------------------------------------------------------------
CONANEXILES_CMD_SWITCHES=

# ---------------------------------------------------------------------------
# INI overrides: CONANEXILES_INI_<FILE>__<SECTION>__<KEY>=<VALUE>
#
# FILE   -- INI base name without extension (Engine, Game, ServerSettings, ...)
# Delimiters are double underscores (__). Section and key names may contain
# underscores, dots, slashes, @, or any other character.
#
# -- Server identity --
# CONANEXILES_INI_Engine__OnlineSubSystemSteam__ServerName=My Server
# CONANEXILES_INI_ServerSettings__ServerSettings__AdminPassword=s3cr3t
# CONANEXILES_INI_ServerSettings__ServerSettings__IsVACEnabled=False
# CONANEXILES_INI_ServerSettings__ServerSettings__IsBattlEyeEnabled=False
# CONANEXILES_INI_ServerSettings__ServerSettings__serverRegion=0
#
# -- RCON --
# CONANEXILES_INI_Game__RconPlugin__RconEnabled=1
# CONANEXILES_INI_Game__RconPlugin__RconPassword=secret
# CONANEXILES_INI_Game__RconPlugin__RconPort=25575
# CONANEXILES_INI_Game__RconPlugin__RconMaxKarma=60
#
# -- Gameplay rates --
# CONANEXILES_INI_ServerSettings__ServerSettings__HarvestAmountMultiplier=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__ResourceRespawnSpeedMultiplier=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__PlayerXPKillMultiplier=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__PlayerHealthRegenSpeedScale=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__NPCRespawnMultiplier=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__NPCMaxSpawnCapMultiplier=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__PlayerKnockbackMultiplier=1.0
#
# -- Player/corpse behaviour --
# CONANEXILES_INI_ServerSettings__ServerSettings__CorpsesPerPlayer=1
# CONANEXILES_INI_ServerSettings__ServerSettings__MaxDeathMapMarkers=50
# CONANEXILES_INI_ServerSettings__ServerSettings__DropEquipmentOnDeath=True
# CONANEXILES_INI_ServerSettings__ServerSettings__EverybodyCanLootCorpse=False
# CONANEXILES_INI_ServerSettings__ServerSettings__LogoutCharactersRemainInTheWorld=False
# CONANEXILES_INI_ServerSettings__ServerSettings__DisableBuildingAbandonment=False
#
# -- Building / map --
# CONANEXILES_INI_ServerSettings__ServerSettings__BuildingPreloadRadius=1
# CONANEXILES_INI_ServerSettings__ServerSettings__RegionBlockList=
#
# -- Network tuning (section names contain dots and slashes) --
# CONANEXILES_INI_Engine__/script/onlinesubsystemutils.ipnetdriver__NetServerMaxTickRate=60
# CONANEXILES_INI_Engine__/script/onlinesubsystemutils.ipnetdriver__MaxClientRate=15000
# CONANEXILES_INI_Engine__/script/onlinesubsystemutils.ipnetdriver__MaxInternetClientRate=10000
# CONANEXILES_INI_Engine__SystemSettings__dw.NetClientFloatsDuringNavWalking=false
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__TotalNetBandwidth=104857600
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MaxDynamicBandwidth=104857600
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MinDynamicBandwidth=10485760
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MoveRepSize=96
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MAXPOSITIONERRORSQUARED=9.0
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MAXCLIENTUPDATEINTERVAL=0.017
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MaxMoveDeltaTime=0.125
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__MaxClientSmoothingDeltaTime=0.5
# CONANEXILES_INI_Game__/script/engine.gamenetworkmanager__ClientAuthorativePosition=false
# CONANEXILES_INI_ServerSettings__ServerSettings__NetworkSimulatedSmoothRotationTimeWithLQAVP=0.2
#
# -- Movement / rotation prediction --
# CONANEXILES_INI_ServerSettings__ServerSettings__TargetPredictionMaxSeconds=1.0
# CONANEXILES_INI_ServerSettings__ServerSettings__TargetPredictionAllowSecondsForAttack=0.3
# CONANEXILES_INI_ServerSettings__ServerSettings__EnforceRotationRateWhenRoaming_2=true
# CONANEXILES_INI_ServerSettings__ServerSettings__EnforceRotationRateInCombat_2=true
# CONANEXILES_INI_ServerSettings__ServerSettings__RotateToTargetSendsAngularVelocity=true
# CONANEXILES_INI_ServerSettings__ServerSettings__PathFollowingSendsAngularVelocity=true
# CONANEXILES_INI_ServerSettings__ServerSettings__UseLocalQuadraticAngularVelocityPrediction=true
# CONANEXILES_INI_ServerSettings__ServerSettings__LQAVPUseTime=0.5
# CONANEXILES_INI_ServerSettings__ServerSettings__LQAVPFadeTime=0.3
# CONANEXILES_INI_ServerSettings__ServerSettings__LQAVPMethod=0
# CONANEXILES_INI_ServerSettings__ServerSettings__ClipVelocityOnNavmeshBoundary=true
# CONANEXILES_INI_ServerSettings__ServerSettings__ValidatePhysNavWalkWithRaycast=true
# CONANEXILES_INI_ServerSettings__ServerSettings__LocalNavMeshVisualizationFrequency=0
#
# -- AI / spawning --
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.EnableAISpawning=true
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.EnableInitialAISpawningPass=true
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.NPCsTargetBuildings=true
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.AILOD1Distance=8000
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.AILOD2Distance=12000
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.AILOD3Distance=20000
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.SkeletalMeshTickRate=30
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.nav.AvoidNonPawns=false
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.nav.InterpolateAvoidanceResult=false
# CONANEXILES_INI_Engine__/script/conansandbox.systemsettings__dw.EnableStaticRoamingPaths=true
# CONANEXILES_INI_Engine__/script/aimodule.crowdmanager__NavmeshCheckInterval=0.5
# CONANEXILES_INI_Engine__/script/aimodule.crowdmanager__PathOptimizationInterval=0.5
# CONANEXILES_INI_Engine__/script/aimodule.crowdmanager__bResolveCollisions=false
# CONANEXILES_INI_Engine__/script/aimodule.aisystem__bAllowStrafing=false
# CONANEXILES_INI_Game__/script/conansandbox.aisenseconfig_newsight__PeripheralVisionAngleDegrees=180.0
# CONANEXILES_INI_Game__/script/aimodule.envquerymanager__MaxAllowedTestingTime=0.01
# CONANEXILES_INI_Game__/script/aimodule.envquerymanager__bTestQueriesUsingBreadth=false
#
# -- Physics --
# CONANEXILES_INI_Game__Settings.Physics.Cloth__MaxClothSimuatingActors=5
# CONANEXILES_INI_Game__Settings.Physics.Cloth__ClothSimulationAdjustmentInterval=0.25
#
# -- Logging (suppress noisy channels) --
# CONANEXILES_INI_Engine__Core.Log__LogStreaming=Error
# CONANEXILES_INI_Engine__Core.Log__GlobalServerChannel=Error
# CONANEXILES_INI_Engine__Core.Log__ConanBattlePass=Error
# CONANEXILES_INI_Engine__Core.Log__SpawnTable=Error
# CONANEXILES_INI_Engine__Core.Log__LogScriptCore=Error
# CONANEXILES_INI_Engine__Core.Log__Network=Error
# CONANEXILES_INI_Engine__Core.Log__LogNetPackageMap=Error
# CONANEXILES_INI_Engine__Core.Log__LogModController=Error
#
# -- Audio --
# CONANEXILES_INI_Engine__/script/engine.audiosettings__bAllowCenterChannel3DPanning=false
#
